# LaTeX build artifacts from standalone figure compilation
scripts/paper/figures/*.aux
scripts/paper/figures/*.log
scripts/paper/figures/pair_schematic.pdf

# Citation skill outputs (regenerated by /citations verify-literature)
paper/claims.jsonl
paper/verification_results.jsonl

# Plain-text dump of paper/main.pdf used for review only
paper/main.txt

