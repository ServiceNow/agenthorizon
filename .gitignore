.claude/notes/reply_to_*
.claude/notes/message_to_*
# Per-session handoff notes (path maps, etc.) — ephemeral working docs
.claude/notes/paths_for_*

# vllm-server runtime state + per-launch logs (regenerated on every launch)
apps/vllm-server/.run-state/
apps/vllm-server/dashboard/state.json
apps/vllm-server/dashboard/launch-logs/
archive/comparer/.cache/*
dashboard/.cache/*
image.png

# Local-only run caches (dashboard_run_stats, experiment_status, etc.)
.cache/

# Per-experiment co-located parse caches
# (experiments/<harness>/<model>/<exp>/.cache/metrics/<tid>.json)
experiments/**/.cache/

# Claude Code internal storage
.claude/projects/
.claude/scheduled_tasks.lock

# Per-skill runtime caches (e.g. Semantic Scholar API responses)
.claude/skills/*/scripts/.api_cache/
.claude/skills/*/.cache/

# Auto-generated API usage tracking
console_usage.jsonl

# Runtime logs from scripts/start_dashboard.sh
scratch/
logs/llm_judges/*.log
apps/presentation/node_modules/*
apps/presentation/serve_root/*

# Raw screenshot assets for paper trajectory mosaic (regenerated from data/standard/)
